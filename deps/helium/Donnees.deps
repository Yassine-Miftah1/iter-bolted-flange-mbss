(* Seuls les materiaux valides a cette temperature (et compatibles avec le tube pour la bride) sont gardes. *)
(* Materiaux de vis a T = 525 C : E(T) EN 13480-3 annexe G ; SadmT = 2/3 Rp02T *)
Table CatMatVis
Attributes
ref : Indice;
rho : MasseVol;
E20 : Pression;
ET : Pression;
Rp02T : Pression;
SadmT : Pression;
Tmin : TempC;
Tmax : TempC;
Tuples
[5, 7940, 201000, 172215, 535, 356.7, -196, 650] (* A286 (1.4980) - EN 10269 / donnees fournisseur *)
End

(* Materiaux de bride a T = 525 C : SadmT = 1.5 f = Rp02T (membrane + flexion) ; admTube : 1 = compatible tube 316L *)
Table CatMatBride
Attributes
ref : Indice;
rho : MasseVol;
E20 : Pression;
ET : Pression;
Rp02T : Pression;
SadmT : Pression;
Tmin : TempC;
Tmax : TempC;
admTube : Indice;
Tuples
[1, 8000, 199964, 157140, 91, 91, -196, 550, 1], (* 316L (1.4404) - RCC-MRx (Rp0.2=101 MPa a 340 C, Zaouter 2020) *)
