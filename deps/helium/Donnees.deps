Package Donnees ;

Uses Universal, Grandeurs ;

(* Joints HELICOFLEX HN200 - catalogue Technetics p.9 et p.12, converti en SI.          *)
(* niv : 1 = bulle, 2 = helium ; jaq : 1 Al, 2 Ag, 3 Cu/fer doux, 4 Ni/Monel, 5 Inox    *)
(* PuT : pression intrinseque a T = 525 C, interpolee (eq. 5.5 du rapport)            *)
(* Catalogue pre-filtre pour la ligne : seuls les joints compatibles (niveau, PuT >= P, plage de diametre) sont gardes. *)
(* Les references avec PuT = 0 a cette temperature (T >= Tmax) sont retirees du catalogue. *)
Table CatJoints
Attributes
ref : Indice;
niv : Indice;
jaq : Indice;
CS : Longueur;
e2 : Longueur;
ec : Longueur;
Y2 : ChargeLin;
Y1 : ChargeLin;
PuAmb : Pression;
PuT : Pression;
Tmax : TempC;
Dmin : Longueur;
Dmax : Longueur;
XlowP : Longueur;
XhighP : Longueur;
F : Longueur;
G : Longueur;
Tuples
[82, 2, 4, 4.4958, 0.7112, 0.9906, 719.946, 150.084, 104.973, 15.596, 600, 50.8, 1016, 0.7112, 0.508, 3.7846, 5.9182], (* HN200 Nickel CS=0.177 in helium *)
[84, 2, 4, 5.0038, 0.7112, 1.0922, 780.015, 180.03, 109.971, 23.744, 650, 76.2, 1270, 0.7112, 0.508, 4.2926, 6.4262], (* HN200 Nickel CS=0.197 in helium *)
[103, 2, 5, 3.9878, 0.7112, 0.9906, 750.068, 170.048, 106.972, 15.746, 600, 44.45, 762, 0.7112, 0.508, 3.2766, 5.4102], (* HN200 Inox CS=0.157 in helium *)
[105, 2, 5, 4.4958, 0.7112, 0.9906, 825.023, 219.959, 109.971, 22.494, 650, 50.8, 1016, 0.7112, 0.508, 3.7846, 5.9182] (* HN200 Inox CS=0.177 in helium *)
End

